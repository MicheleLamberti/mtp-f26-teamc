	(text "RADIO – socket for the lab-made E01-ML01SP4 breakout"
		(exclude_from_sim no)
		(at 25.4 20.32 0)
		(effects
			(font
				(size 2.5 2.5)
			)
			(justify left top)
		)
		(uuid "077c7ce9-e30f-5e77-bebd-1c48da6b6717")
	)
	(text "DRAFT – for ET review.\nVCC 2.0–3.6 V, ABS. MAX 3.6 V: only 3V3_RADIO from the AP2112K on the power sheet (enabled by the Pi's 3V3,\nso the radio is off whenever the Pi is off). Never the cell, never the Pi's 3V3 pin.\nThe breakout has the module's 100 uF + 10 uF + 100 nF. Rev B: no socket-end cap (rev A C71) and no test loop\n(rev A TP10): C12 (10 uF) at the LDO is 6 mm from the socket, and 3V3_RADIO is probed on C12's pad.\nPlace J30 so the breakout's IPEX end faces the board edge, far from the boost module; M3 standoff at the\nbreakout's H1 (H30 here, ~11 mm standoff = socket + header height). Antenna: TX2400-FPC-2509 flex on a box\nwall on the U.FL (glue the plug, drop test)."
		(exclude_from_sim no)
		(at 25.4 27.94 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left top)
		)
		(uuid "4a94523a-fa16-5c0d-b103-57339315ddaf")
	)
	(text "BREAKOUT SOCKET"
		(exclude_from_sim no)
		(at 165.1 81.28 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left top)
		)
		(uuid "57b5e3aa-4f8d-5f5d-ab76-d8a87f3b5b71")
	)
	(text "SPI SOURCE TERMINATION (33 Ω)"
		(exclude_from_sim no)
		(at 25.4 81.28 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left top)
		)
		(uuid "c969366c-dc3c-5a2d-9790-f1b5732c0282")
	)
	(text "R82 SCK, R83 MOSI: at the IDC header J1 (drivers = Pi, through the ribbon).\nR84 MISO: at J30 (driver = SP4). The ribbon adds ~10 cm: keep these (0 Ω if the bench shows no need)."
		(exclude_from_sim no)
		(at 25.4 144.78 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
