	(text "PULL-UP TO 3V3_RADIO"
		(exclude_from_sim no)
		(at 25.4 172.72 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left top)
		)
		(uuid "cebe15ef-320c-5d1e-94b2-e02e12d490da")
	)
	(text "R80: CSN high = radio deselected while the Pi boots.\nRev B: to 3V3_RADIO (rev A: 3V3_PI), so it sits at the socket without a 3V3_PI track there on the single\ncopper layer. 3V3_RADIO comes up with 3V3_PI (the LDO's EN is 3V3_PI): CSN is still high from the first\nmilliseconds of the Pi's boot, and both rails are off together.\nNo IRQ pull-up in rev B (rev A R81): the Linux HAL requests the Pi's pull-up on GPIO 24 (IRQ is open drain,\nfalling edge only; radio/fw/linux/nrf24_hal_linux.c), and on one copper layer 3V3 does not reach pin 8."
		(exclude_from_sim no)
		(at 25.4 218.44 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "8968db0e-5803-5308-aa00-760372fce685")
	)
	(embedded_fonts no)
)
