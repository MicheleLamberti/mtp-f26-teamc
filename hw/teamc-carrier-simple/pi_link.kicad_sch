	(text "PI LINK – Raspberry Pi 3 Model A+ on a 40-wire ribbon"
		(exclude_from_sim no)
		(at 25.4 20.32 0)
		(effects
			(font
				(size 2.5 2.5)
			)
			(justify left top)
		)
		(uuid "7e251f55-169c-5946-bdcc-291a697277c5")
	)
	(text "J1 is a shrouded (keyed) 2x20 box header; a 15 cm 40-wire female-female ribbon goes to the Pi's GPIO header.\nThe key stops it going in rotated. Red wire = pin 1 at both ends.\n5V_PI (pins 2, 4) comes from the ideal diode on the power sheet. All eight GND pins go to the carrier ground:\nthey are the return path of the Pi's supply and of the SPI signals.\n3V3_PI = the Pi's own 3.3 V, from pin 1 only (pin 17 unused): it only feeds the fuel gauge's I2C pull-ups.\nPins 27/28 (ID EEPROM) stay unconnected. The Pi's WiFi/BT chip is disabled or removed (Atenea Q22).\nDo not power the Pi from its micro-USB while the box is on (the ideal diode protects the boost, but two\nsupplies would share the Pi). For development: unplug the ribbon, or switch the box off."
		(exclude_from_sim no)
		(at 25.4 27.94 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left top)
		)
		(uuid "25c3b05d-abd0-5d4e-b19c-7afc8dd5ff4e")
	)
	(text " 1  3V3 (feeds 3V3_PI: the fuel gauge's I2C pull-ups only)"
		(exclude_from_sim no)
		(at 137.16 123.82 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "136d9ba4-8fb6-5358-b082-b39192fd8288")
	)
	(text " 2  5V"
		(exclude_from_sim no)
		(at 246.38 123.82 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "6e002922-489f-5173-b04d-1348abb2151f")
	)
	(text " 3  GPIO 2 SDA1"
		(exclude_from_sim no)
		(at 137.16 126.36 0)
		(effects
