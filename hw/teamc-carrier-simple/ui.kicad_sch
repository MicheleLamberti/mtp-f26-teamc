	(text "UI – panel controls and LEDs on JST-XH leads"
		(exclude_from_sim no)
		(at 25.4 20.32 0)
		(effects
			(font
				(size 2.5 2.5)
			)
			(justify left top)
		)
		(uuid "d6dd13b6-a4cd-595f-a96f-43be57186359")
	)
	(text "Every panel part sits on the box wall and plugs into the board with a JST-XH lead (glue the housings and\ntie the leads down for the drop test). Inputs: the switch pulls the GPIO to GND; the Pi's own pull-up\n(turned on by ui.c) holds it high otherwise. 1 kΩ + 100 nF protect the GPIO from a zap on a metal lever\nand from a GPIO driven by old firmware at boot (GPIO 16). LEDs light when the GPIO is high.\nPanel holes: Ø7.5 mm for the PS1024 button, Ø6.5 mm for the 100-series toggles, Ø8 mm for the LED clips."
		(exclude_from_sim no)
		(at 25.4 27.94 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left top)
		)
		(uuid "b8757cfb-8700-5923-b3ba-21c65bd62d3d")
	)
	(text "CONNECTORS (panel parts off-board)"
		(exclude_from_sim no)
		(at 25.4 81.28 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left top)
		)
		(uuid "f7fbe73d-e134-5394-814e-cc088bd61a32")
	)
	(text "J10: GO/STOP button (also the bench button: bridge its two pins).\nJ11: role toggle, closed = TX, open = RX (may stay unfitted until Atenea Q8).\nJ12: mode toggle ON-OFF-ON: 1 NM, 2 common (GND), 3 MRM; centre = SRI."
		(exclude_from_sim no)
		(at 25.4 172.72 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "5c5871aa-4313-5887-94c9-d0ea7d57b9ea")
	)
	(text "SERIES 1 kΩ"
		(exclude_from_sim no)
		(at 147.32 81.28 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left top)
		)
		(uuid "156a044a-61ff-56fe-9e50-e01eb6e0f497")
	)
	(text "100 nF AT THE GPIO"
		(exclude_from_sim no)
		(at 213.36 81.28 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left top)
		)
		(uuid "2fa92ac8-d3f9-5291-9fc6-eef91fb347f4")
	)
	(text "GPIO 17, GO/STOP, low = pressed"
		(exclude_from_sim no)
		(at 238.76 98.42 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "35d602d3-e420-5d70-9299-704446a8665e")
	)
	(text "GPIO 27, role, low = TX"
		(exclude_from_sim no)
		(at 238.76 118.74 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "88195ce2-0151-571b-98b3-f12a10a54978")
	)
	(text "GPIO 23, low = NM"
		(exclude_from_sim no)
		(at 238.76 139.06 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "4b796d66-966d-5b7c-98e1-a36e18d301e8")
	)
	(text "GPIO 16, low = MRM (neither = SRI)"
		(exclude_from_sim no)
		(at 238.76 159.38 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "3ee6f4c7-e880-56e5-a976-a2cd32a542a0")
	)
	(text "LEDs (5 mm, in panel clips; ≈ 4 mA from 3.3 V)"
		(exclude_from_sim no)
		(at 147.32 187.96 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left top)
		)
		(uuid "d2f2006b-4579-5e72-85e6-5df7672f6931")
	)
	(text "J14 lead: pin 1 to the green LED's long leg (activity, GPIO 5), pin 2 to the red LED's long leg\n(status, GPIO 6), pin 3 to both short legs. (3.3 V - ~2.0 V) / 330 Ω ≈ 4 mA, far under the Pi's\n16 mA per pin. Red/green/yellow only (blue/white need more voltage than 3.3 V leaves)."
		(exclude_from_sim no)
		(at 147.32 243.84 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "4f3258f1-c7d1-54c3-9885-f14f28354d23")
	)
	(embedded_fonts no)
)
