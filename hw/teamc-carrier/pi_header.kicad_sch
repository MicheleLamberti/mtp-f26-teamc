	(text "PI HEADER – Raspberry Pi 3 Model A+ only (65 x 56 mm)"
		(exclude_from_sim no)
		(at 25.4 20.32 0)
		(effects
			(font
				(size 2.5 2.5)
			)
			(justify left top)
		)
		(uuid "d723d2fb-77aa-5224-b178-bfe88b92ac27")
	)
	(text "DRAFT – for ET review. The HAT sits on the Pi's 40-pin header (J1, socket on the HAT's underside).\nNo ID EEPROM: pins 27/28 (ID_SD/ID_SC) stay unconnected (allowed for a non-'HAT' add-on board).\nThe Pi's WiFi/BT chip is disabled in software or desoldered (rules p.6, Atenea Q22).\n5V_PI comes from the power sheet's ideal diode (back-feeds the Pi's 5 V after its polyfuse).\n3V3_PI = the Pi's own 3.3 V (pins 1/17): pull-ups only, no load. The radio has its own LDO (3V3_RADIO)."
		(exclude_from_sim no)
		(at 25.4 27.94 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left top)
		)
		(uuid "5d233c25-f3ca-5cec-89ca-e7de1950b49b")
	)
