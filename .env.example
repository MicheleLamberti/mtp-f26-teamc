# MTP-F26 Team C - settings for the two Raspberry Pi 3 A+ boxes (D-H1).
# Copy to .env (ignored, never committed) and fill in: cp .env.example .env
# Per-box values are suffixed _C1 / _C2 (the label on the box).
# Where each value goes: proto/port/linux/README.md "Pi setup", radio/fw/linux/README.md.

# --- Set in Raspberry Pi Imager (OS customisation), not here ----------------------------------------
# WiFi SSID/password, each Pi's username/password and the Raspberry Pi Connect auth token live in the
# Imager settings and on the cards. Keep them out of this file and out of the repository.
PI_OS="Raspberry Pi OS Lite (64-bit)"
PI_HOSTNAME_C1=
PI_HOSTNAME_C2=
PI_USER_C1=
PI_USER_C2=
PI_SSH_PUBKEY_FILE=~/.ssh/id_ed25519.pub

# --- Wireless: development only ----------------------------------------------------------------------
# The rules (p.6) ban an active WiFi/BT chip (Atenea Q22). WiFi + Pi Connect are for developing only.
# Before QM / any test day: sudo systemctl disable --now rpi-connect (or rpi-connect-lite), then
# dtoverlay=disable-wifi + disable-bt in /boot/firmware/config.txt (README step 1). After that the Pi
# is reached over a serial console or a keyboard + HDMI, not SSH/Connect.

# --- SD card layout (README step 2) ---------------------------------------------------------------
# Card: SanDisk Ultra 32 GB A1. Data partition at /data; root goes read-only (overlayfs) afterwards.
# The first boot grows the root partition over the whole card, so p3 needs root shrunk offline (another
# Linux PC) or a re-flash. While developing, /data as a plain directory on the root is enough.
DATA_PART=/dev/mmcblk0p3
DATA_SIZE=4G
DATA_MOUNT=/data

# --- Repository -----------------------------------------------------------------------------------
REPO_URL=https://github.com/SantiBarrios2002/mtp-f26-teamc.git
REPO_DIR=~/mtp-f26-teamc

# --- teamc-node / nrf24_probe options (defaults of node.c; wiring in radio/fw/linux/README.md) ---
TEAMC_DATA=/data/teamc
TEAMC_RT_CPU=3              # isolcpus=3 in cmdline.txt
TEAMC_SPIDEV=/dev/spidev0.0 # SP4 CSN on pin 24 (CE0)
TEAMC_GPIOCHIP=/dev/gpiochip0
TEAMC_CE_GPIO=22            # header pin 15
TEAMC_IRQ_GPIO=24           # header pin 18 (-1 = poll)
TEAMC_I2C=/dev/i2c-1        # MAX17048 fuel gauge (HAT)
TEAMC_STICK=/dev/sda
TEAMC_SRI_PROFILE=TEAM_250K
TEAMC_MRM_PROFILE=TEAM_FHSS
TEAMC_TEXT_ENCODING=auto
TEAMC_TEXT_BOM_POLICY=strict
