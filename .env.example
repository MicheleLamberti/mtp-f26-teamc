# MTP-F26 Team C - settings for setting up the two Raspberry Pi 3 A+ boxes (D-H1).
# Copy to .env (git-ignored: it holds the WiFi password and the Pi login) and fill in the blanks:
#   cp .env.example .env
# One file covers both boxes; per-box values are suffixed _C1 / _C2 (the label on the box).
# Where each value goes: proto/port/linux/README.md "Pi setup", radio/fw/linux/README.md.

# --- Raspberry Pi Imager (OS customisation) -----------------------------------------------------
PI_OS="Raspberry Pi OS Lite (64-bit)"
PI_HOSTNAME_C1=teamc-c1
PI_HOSTNAME_C2=teamc-c2
PI_USER=teamc
PI_PASSWORD=
# Public key copied into ~/.ssh/authorized_keys (Imager: "Allow public-key authentication only")
PI_SSH_PUBKEY_FILE=~/.ssh/id_ed25519.pub
PI_TIMEZONE=Europe/Madrid
PI_KEYBOARD=es
PI_LOCALE=en_GB.UTF-8

# --- WiFi: development only ----------------------------------------------------------------------
# The rules (p.6) ban an active WiFi/BT chip (Atenea Q22): WiFi is on only for SSH while developing.
# Before QM / any test day: dtoverlay=disable-wifi + disable-bt in config.txt (README step 1).
# eduroam is WPA2-Enterprise and Imager cannot set it up; a phone hotspot is the easy option.
WIFI_COUNTRY=ES
WIFI_SSID=
WIFI_PSK=

# --- SD card layout (README step 2) ---------------------------------------------------------------
# Card: SanDisk Ultra 32 GB A1. Data partition at /data; root goes read-only (overlayfs) afterwards.
DATA_PART=/dev/mmcblk0p3
DATA_SIZE=4G
DATA_MOUNT=/data

# --- Repository -----------------------------------------------------------------------------------
REPO_URL=https://github.com/SantiBarrios2002/mtp-f26-teamc.git
REPO_DIR=~/mtp-f26-teamc

# --- teamc-node / nrf24_probe options (defaults of node.c; wiring in radio/fw/linux/README.md) ---
TEAMC_DATA=/data/teamc
TEAMC_RT_CPU=3              # isolcpus=3 in cmdline.txt
TEAMC_SPIDEV=/dev/spidev0.0 # SP4 CSN on pin 24 (CE0)
TEAMC_GPIOCHIP=/dev/gpiochip0
TEAMC_CE_GPIO=22            # header pin 15
TEAMC_IRQ_GPIO=24           # header pin 18 (-1 = poll)
TEAMC_I2C=/dev/i2c-1        # MAX17048 fuel gauge (HAT)
TEAMC_STICK=/dev/sda
TEAMC_SRI_PROFILE=TEAM_250K
TEAMC_MRM_PROFILE=TEAM_FHSS
TEAMC_TEXT_ENCODING=auto
TEAMC_TEXT_BOM_POLICY=strict
