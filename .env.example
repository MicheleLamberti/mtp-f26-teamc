# MTP-F26 Team C - access to the two Raspberry Pi 3 A+ boxes. Copy to .env (ignored by the repo) and fill in:
#   cp .env.example .env
# Never commit, paste or share .env (passwords). How to connect: PI_ACCESS.md.
# WiFi, the logins and the Raspberry Pi Connect token are set in Raspberry Pi Imager when flashing.

# --- C1 -------------------------------------------------------------------------------------------
PI_HOSTNAME_C1=mtp-team-c1
PI_USER_C1=mtp-team-c1
PI_PASSWORD_C1=
PI_IP_C1=

# --- C2 -------------------------------------------------------------------------------------------
PI_HOSTNAME_C2=mtp-team-c2
PI_USER_C2=mtp-team-c2
PI_PASSWORD_C2=
PI_IP_C2=

# --- This PC --------------------------------------------------------------------------------------
PI_SSH_PUBKEY_FILE=~/.ssh/id_ed25519.pub
